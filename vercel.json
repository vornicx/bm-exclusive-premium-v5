{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/cars", "destination": "/catalog"},
    {"source": "/cars/:slug", "destination": "/catalog"},
    {"source": "/properties", "destination": "/catalog"},
    {"source": "/properties/:slug", "destination": "/catalog"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
